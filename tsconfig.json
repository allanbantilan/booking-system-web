{
    "compilerOptions": {
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "baseUrl": ".",
        "esModuleInterop": true,
        "ignoreDeprecations": "6.0",
        "isolatedModules": true,
        "jsx": "preserve",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "paths": { "@/*": ["resources/js/*"] },
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": false,
        "target": "ES2022",
        "types": ["vite/client"]
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.vue", "vite.config.js"]
}
